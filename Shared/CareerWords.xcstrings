    "recoveryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One recovery session between matches. Stamina reduces match fatigue. You can always play the next match."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erholung zwischen Spielen. Ausdauer senkt die Ermüdung. Das nächste Spiel ist immer verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma recuperação entre partidas. Resistência reduz o cansaço. Você sempre pode jogar a próxima partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une récupération entre les matchs. L'endurance réduit la fatigue. Le prochain match reste accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una recuperación entre partidos. La resistencia reduce el cansancio. Siempre puedes jugar el siguiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно восстановление между матчами. Выносливость уменьшает усталость. Следующий матч доступен всегда."
          }
        }
      }
    },
