    "privacyText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your names, careers and results stay on this device and in its private widget container. No accounts, analytics, tracking or network requests. Device backups follow your system settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, Karrieren und Ergebnisse bleiben auf diesem Gerät und im privaten Widget-Container. Keine Konten, Analysen, Ortung oder Netzwerkanfragen. Backups folgen den Systemeinstellungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes, carreiras e resultados ficam neste dispositivo e no contêiner privado dos widgets. Sem contas, análises, rastreamento ou rede. Backups seguem os ajustes do sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms, carrières et résultats restent sur cet appareil et dans le conteneur privé des widgets. Aucun compte, suivi, analyse ou requête réseau. Sauvegardes selon les réglages système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres, carreras y resultados se guardan en el dispositivo y el contenedor privado de widgets. Sin cuentas, análisis, rastreo ni red. Copias según ajustes del sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, карьеры и результаты хранятся на устройстве и в закрытом контейнере виджетов. Нет аккаунтов, аналитики, отслеживания и сетевых запросов. Резервные копии зависят от настроек системы."
          }
        }
      }
    },
    "deleteHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete a career above to remove its local progress. Up to four separate careers can be saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche eine Karriere oben, um den Fortschritt zu entfernen. Bis zu vier Karrieren sind möglich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua uma carreira acima para remover seu progresso. Até quatro carreiras podem ser salvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez une carrière ci-dessus pour effacer sa progression. Jusqu'à quatre carrières."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una carrera arriba para borrar su progreso. Se guardan hasta cuatro carreras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление карьеры стирает её локальный прогресс. Можно хранить до четырёх карьер."
          }
        }
      }
    },
    "about": {
