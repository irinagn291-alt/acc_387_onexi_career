    "transferIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fictional clubs, real progress. Offers open after a complete season when your record meets the next club's requirements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiktive Vereine, echter Fortschritt. Angebote öffnen nach einer Saison bei erfüllten Anforderungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clubes fictícios, progresso real. As propostas abrem após a temporada se você cumprir os requisitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clubs fictifs, vraie progression. Les offres arrivent après la saison si les critères sont remplis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clubes ficticios, progreso real. Las ofertas llegan tras la temporada si cumples los requisitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вымышленные клубы и настоящий прогресс. Предложения открываются в конце сезона при выполнении требований."
          }
        }
      }
