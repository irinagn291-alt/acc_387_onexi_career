    "reminderExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional local reminders for your next match and season finish. Enable them when you want a nudge to return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale lokale Hinweise für das nächste Spiel und Saisonende. Aktiviere sie bei Bedarf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes locais opcionais para a próxima partida e fim da temporada. Ative quando desejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels locaux facultatifs pour le prochain match et la fin de saison. Activez-les à votre convenance."
          }
        },
        "es": {
