    "reminderScheduleHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing a match moves the next reminder one day ahead. The season reminder assumes one match per day. Nothing plays automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Spiel verschiebt den Hinweis um einen Tag. Die Saisonerinnerung rechnet mit einem Spiel pro Tag. Kein automatisches Spielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar adia o próximo lembrete em um dia. O lembrete de temporada considera um jogo por dia. Nada é jogado automaticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un match reporte le rappel d'un jour. Le rappel de saison suppose un match par jour. Aucun match automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar mueve el próximo aviso un día. El aviso de temporada supone un partido diario. Nada se juega automáticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После матча напоминание переносится на сутки. Конец сезона рассчитан по одному матчу в день. Матчи не играются автоматически."
          }
        }
      }
    },
