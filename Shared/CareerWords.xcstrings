    "aboutText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An original, fully offline football career simulation. All players, clubs and matches are fictional. No purchases or advertising."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigenständige Offline-Fußballkarriere. Alle Spieler, Vereine und Spiele sind fiktiv. Ohne Käufe oder Werbung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulação original de carreira no futebol, totalmente offline. Jogadores, clubes e partidas fictícios. Sem compras ou publicidade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulation originale de carrière de football hors ligne. Joueurs, clubs et matchs fictifs. Sans achats ni publicité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulación original de carrera de fútbol sin conexión. Jugadores, clubes y partidos ficticios. Sin compras ni publicidad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторская офлайн-симуляция футбольной карьеры. Все игроки, клубы и матчи вымышлены. Без покупок и рекламы."
          }
        }
      }
    },
