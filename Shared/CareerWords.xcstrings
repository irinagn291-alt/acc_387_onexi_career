    "createIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a footballer. Train your strengths, play every fixture, and write your own club story."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Fußballprofi. Trainiere, spiele und schreibe deine Vereinsgeschichte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie seu jogador. Treine, dispute partidas e escreva sua história nos clubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un joueur. Entraînez-vous, disputez les matchs et écrivez votre histoire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un futbolista. Entrena, juega y escribe tu historia en los clubes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай футболиста. Развивай навыки, играй матчи и пиши свою клубную историю."
          }
        }
      }
    },
