    "rule1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create up to four players. Each begins at Lumen Academy with eight practice points and a position-specific strength."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle bis zu vier Spieler. Jeder startet bei Lumen Academy mit acht Trainingspunkten und einer Positionsstärke."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie até quatro jogadores. Cada um começa no Lumen Academy com oito pontos e uma habilidade de posição."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez jusqu'à quatre joueurs. Chacun débute à Lumen Academy avec huit points et un atout lié au poste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea hasta cuatro jugadores. Cada uno empieza en Lumen Academy con ocho puntos y una fortaleza según posición."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай до четырёх игроков. Каждый начинает в Lumen Academy с восемью очками практики и сильным профильным навыком."
          }
        }
      }
    },
    "rule2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A season has 14 rounds. All eight clubs play once each round. Three points for a win, one for a draw. Ties are separated by goal difference, then goals scored, then club order."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Saison hat 14 Runden. Acht Vereine spielen jede Runde. Sieg: drei Punkte, Remis: einer. Bei Gleichstand zählen Tordifferenz, Tore, dann Vereinsreihenfolge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São 14 rodadas. Os oito clubes jogam em cada rodada. Vitória: três pontos; empate: um. Desempate por saldo, gols marcados e ordem dos clubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une saison compte 14 journées. Les huit clubs jouent à chaque journée. Victoire : trois points, nul : un. Départage par différence de buts, buts marqués, puis ordre des clubs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay 14 jornadas. Los ocho clubes juegan en cada una. Victoria: tres puntos; empate: uno. Desempate por diferencia de goles, goles a favor y orden de clubes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сезоне 14 туров. Все восемь клубов играют каждый тур. Победа — три очка, ничья — одно. При равенстве учитываются разница голов, забитые голы и порядок клубов."
          }
        }
      }
    },
    "rule3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills, team strength, fitness, home advantage and your approach affect scoring chances. A strong player can still lose. Reports show your own goals, assists and match rating."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fähigkeiten, Teamstärke, Fitness, Heimvorteil und Taktik beeinflussen Chancen. Auch starke Spieler verlieren. Berichte zeigen deine Tore, Vorlagen und Bewertung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilidades, força do time, forma, mando e estratégia afetam as chances. Um bom jogador também perde. Relatórios mostram seus gols, assistências e nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compétences, équipe, forme, domicile et approche influencent les occasions. Même un joueur fort peut perdre. Les rapports affichent vos buts, passes et note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilidades, equipo, forma, localía y enfoque afectan las ocasiones. Un buen jugador también puede perder. Los informes muestran tus goles, asistencias y nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навыки, команда, форма, своё поле и тактика влияют на моменты. Сильный игрок тоже может проиграть. Отчёт показывает личные голы, передачи и оценку."
          }
        }
      }
    },
    "rule4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training costs practice points and six fitness. One recovery session restores 30 fitness between matches. Better stamina reduces fatigue. There is no real-time wait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Training kostet Punkte und sechs Fitness. Eine Erholung bringt 30 Fitness zwischen Spielen. Ausdauer senkt Ermüdung. Keine Wartezeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treinar custa pontos e seis de forma. Uma recuperação restaura 30 de forma entre jogos. Resistência reduz fadiga. Sem espera em tempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entraînement coûte des points et six de forme. Une récupération rend 30 de forme entre les matchs. L'endurance réduit la fatigue. Aucun délai réel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenar cuesta puntos y seis de forma. Una recuperación restaura 30 entre partidos. La resistencia reduce fatiga. Sin espera real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировка стоит очки практики и шесть единиц формы. Восстановление возвращает 30 формы раз между матчами. Выносливость снижает усталость. Ожидания нет."
          }
        }
      }
    },
    "rule5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a season to earn trophies and review club offers. Requirements use career totals. Moving clubs starts a new season while preserving your player and archive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die Saison für Trophäen und Angebote. Anforderungen nutzen Karrierewerte. Ein Wechsel startet eine Saison, Spieler und Archiv bleiben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a temporada para ganhar troféus e ver propostas. Requisitos usam totais da carreira. Mudar de clube inicia temporada mantendo jogador e arquivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez une saison pour les trophées et offres. Les critères portent sur la carrière. Un transfert lance une saison en conservant joueur et archives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la temporada para conseguir trofeos y ofertas. Los requisitos usan totales de carrera. Cambiar de club inicia temporada conservando jugador y archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заверши сезон ради трофеев и предложений. Требования учитывают всю карьеру. Переход начинает сезон, сохраняя игрока и архив."
          }
        }
      }
    },
    "saveDamaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved career file could not be read. It has not been changed. Restart the app before creating a new career if you want to preserve it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karrieredatei ist unlesbar und wurde nicht geändert. Starte neu, bevor du eine neue Karriere erstellst, um sie zu bewahren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo. Ele não foi alterado. Reinicie antes de criar nova carreira se quiser preservá-lo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est illisible et n'a pas été modifié. Redémarrez avant de créer une carrière si vous souhaitez le conserver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo. No se ha modificado. Reinicia antes de crear otra carrera si deseas conservarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл карьеры не читается и не изменён. Чтобы сохранить его, перезапусти приложение до создания новой карьеры."
          }
        }
      }
    },
    "saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress could not be saved. Check available device storage and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt konnte nicht gespeichert werden. Prüfe freien Speicher und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Verifique o espaço do dispositivo e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer. Vérifiez le stockage disponible puis réessayez."
